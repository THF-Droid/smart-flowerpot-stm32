// ============================================================
// 文件名: smart_flowerpot_esp32s3.ino
// 功能:   STM32 ↔ ESP32-S3 ↔ OneNet 云平台 数据桥接
// ============================================================

#include <WiFi.h>
#include <PubSubClient.h>
#include <ArduinoJson.h>

// ─── WiFi 配置 ─────────────────────────────────────────────
const char* WIFI_SSID     = "你的WiFi名称";
const char* WIFI_PASSWORD = "你的WiFi密码";

// ─── OneNet MQTT 配置 ─────────────────────────────────────
const char* MQTT_SERVER   = "mqtts.heclouds.com";
const int   MQTT_PORT     = 1883;
const char* PRODUCT_ID    = "你的产品ID";       // 例如 "ABC123DEF4"
const char* DEVICE_NAME   = "flowerpot_01";     // 设备名称
const char* DEVICE_KEY    = "你的设备密钥";      // 创建设备时生成

// ─── UART 引脚定义 ─────────────────────────────────────────
#define STM32_RX_PIN   16   // ESP32-S3 RX2, 接 STM32 PC6(TX)
#define STM32_TX_PIN   17   // ESP32-S3 TX2, 接 STM32 PC7(RX)

// ─── 全局变量 ──────────────────────────────────────────────
HardwareSerial stm32Serial(2);  // 使用硬件串口 UART2

// 传感器数据（STM32 发来的最新值）
float g_temp  = 0.0;
float g_humi  = 0.0;
int   g_soil  = 0;
float g_light = 0.0;
int   g_ai    = 0;
bool  g_data_updated = false;   // 标记是否有新数据

// MQTT 客户端
WiFiClient    wifiClient;
PubSubClient  mqttClient(wifiClient);

// JSON 文档缓冲区
StaticJsonDocument<512> jsonDoc;

// 定时器
unsigned long lastPublishTime = 0;
const unsigned long PUBLISH_INTERVAL = 3000;  // 3秒上报一次


// ============================================================
// 函数: MQTT 消息回调（处理 OneNet 下发的命令）
// ============================================================
void mqttCallback(char* topic, byte* payload, unsigned int length) {
    // 构造 JSON 解析
    StaticJsonDocument<256> cmdDoc;
    DeserializationError err = deserializeJson(cmdDoc, payload, length);
    if (err) {
        Serial.print("[MQTT] JSON解析失败: ");
        Serial.println(err.c_str());
        return;
    }

    // OneNet 命令下发格式: {"id":"xxx","version":"1.0","params":{"cmd":"ON"}}
    // 或属性设置格式: {"id":"xxx","version":"1.0","params":{"fan":true}}
    const char* cmd = cmdDoc["params"]["cmd"];
    if (cmd != NULL && strlen(cmd) > 0) {
        Serial.printf("[MQTT] 收到命令: %s\n", cmd);

        // 转发给 STM32（追加换行符作为命令结束标志）
        stm32Serial.println(cmd);
        Serial.printf("[UART] 已转发命令到STM32: %s\n", cmd);
    }

    // 也可以处理属性设置的逐项控制
    if (cmdDoc["params"].containsKey("fan")) {
        bool fan_on = cmdDoc["params"]["fan"];
        stm32Serial.println(fan_on ? "AF" : "AO");
    }
    if (cmdDoc["params"].containsKey("bulb")) {
        bool bulb_on = cmdDoc["params"]["bulb"];
        stm32Serial.println(bulb_on ? "BO" : "BF");
    }
    if (cmdDoc["params"].containsKey("pump")) {
        bool pump_on = cmdDoc["params"]["pump"];
        stm32Serial.println(pump_on ? "CO" : "CF");
    }
    if (cmdDoc["params"].containsKey("servo")) {
        int angle = cmdDoc["params"]["servo"];
        stm32Serial.printf("SERVO_%d\n", angle);
    }
}


// ============================================================
// 函数: 连接 MQTT（含自动重连）
// ============================================================
void connectMQTT() {
    while (!mqttClient.connected()) {
        Serial.print("[MQTT] 正在连接 OneNet...");

        // OneNet MQTT 认证格式:
        // ClientID = device_name
        // Username = product_id
        // Password = device_key
        if (mqttClient.connect(DEVICE_NAME, PRODUCT_ID, DEVICE_KEY)) {
            Serial.println(" 连接成功!");

            // 订阅命令下发主题
            String cmdTopic = String("$sys/") + PRODUCT_ID + "/" + DEVICE_NAME + "/cmd/request/+";
            mqttClient.subscribe(cmdTopic.c_str());
            Serial.printf("[MQTT] 已订阅: %s\n", cmdTopic.c_str());

            // 订阅属性设置主题（OneNet Studio 的属性设置）
            String propSetTopic = String("$sys/") + PRODUCT_ID + "/" + DEVICE_NAME + "/thing/property/set";
            mqttClient.subscribe(propSetTopic.c_str());
            Serial.printf("[MQTT] 已订阅: %s\n", propSetTopic.c_str());

        } else {
            Serial.printf(" 失败, rc=%d, 5秒后重试\n", mqttClient.state());
            delay(5000);
        }
    }
}


// ============================================================
// 函数: 上报传感器数据到 OneNet
// ============================================================
void publishSensorData() {
    if (!mqttClient.connected()) return;

    jsonDoc.clear();
    JsonArray dpArray = jsonDoc.createNestedArray("dp");

    // 温度
    JsonObject dp_temp = dpArray.createNestedObject();
    dp_temp["id"] = "temp";
    dp_temp["v"]  = g_temp;

    // 湿度
    JsonObject dp_humi = dpArray.createNestedObject();
    dp_humi["id"] = "humi";
    dp_humi["v"]  = g_humi;

    // 土壤湿度
    JsonObject dp_soil = dpArray.createNestedObject();
    dp_soil["id"] = "soil";
    dp_soil["v"]  = g_soil;

    // 光照强度
    JsonObject dp_light = dpArray.createNestedObject();
    dp_light["id"] = "light";
    dp_light["v"]  = g_light;

    // AI 状态
    JsonObject dp_ai = dpArray.createNestedObject();
    dp_ai["id"] = "ai_status";
    dp_ai["v"]  = g_ai;

    String payload;
    serializeJson(jsonDoc, payload);

    String pubTopic = String("$sys/") + PRODUCT_ID + "/" + DEVICE_NAME + "/dp/post/json";
    if (mqttClient.publish(pubTopic.c_str(), payload.c_str())) {
        Serial.printf("[Publish] 数据已上报: %s\n", payload.c_str());
    } else {
        Serial.println("[Publish] 上报失败!");
    }
}


// ============================================================
// 函数: 接收并解析 STM32 发来的 JSON 数据
// ============================================================
void readSTM32Data() {
    if (!stm32Serial.available()) return;

    String line = stm32Serial.readStringUntil('\n');
    line.trim();  // 去除首尾空白和 \r

    if (line.length() == 0) return;

    // 解析 JSON: {"temp":25.3,"humi":60.5,"soil":45,"light":1200,"ai":0}
    StaticJsonDocument<256> doc;
    DeserializationError err = deserializeJson(doc, line);
    if (err) {
        Serial.printf("[UART] JSON解析失败: %s\n", err.c_str());
        Serial.printf("[UART] 原始数据: %s\n", line.c_str());
        return;
    }

    g_temp  = doc["temp"]  | 0.0f;
    g_humi  = doc["humi"]  | 0.0f;
    g_soil  = doc["soil"]  | 0;
    g_light = doc["light"] | 0.0f;
    g_ai    = doc["ai"]    | 0;
    g_data_updated = true;

    Serial.printf("[UART] 收到: T=%.1f℃ H=%.1f%% S=%d%% L=%.0flux AI=%d\n",
                  g_temp, g_humi, g_soil, g_light, g_ai);
}


// ============================================================
// 函数: 连接 WiFi
// ============================================================
void connectWiFi() {
    Serial.printf("[WiFi] 正在连接 %s", WIFI_SSID);
    WiFi.begin(WIFI_SSID, WIFI_PASSWORD);

    int retry = 0;
    while (WiFi.status() != WL_CONNECTED && retry < 30) {
        delay(1000);
        Serial.print(".");
        retry++;
    }

    if (WiFi.status() == WL_CONNECTED) {
        Serial.println("\n[WiFi] 连接成功!");
        Serial.printf("[WiFi] IP地址: %s\n", WiFi.localIP().toString().c_str());
    } else {
        Serial.println("\n[WiFi] 连接失败，请检查SSID/密码");
    }
}


// ============================================================
// setup() — 初始化
// ============================================================
void setup() {
    // 1. USB 串口（调试输出）
    Serial.begin(115200);
    delay(500);
    Serial.println("\n========================================");
    Serial.println("  智能花盆 ESP32-S3 数据桥接程序");
    Serial.println("========================================");

    // 2. 初始化 STM32 通信串口 UART2
    stm32Serial.begin(115200, SERIAL_8N1, STM32_RX_PIN, STM32_TX_PIN);
    Serial.println("[UART] STM32通信串口已初始化 (115200 8N1)");

    // 3. 连接 WiFi
    connectWiFi();

    // 4. 配置 MQTT
    mqttClient.setServer(MQTT_SERVER, MQTT_PORT);
    mqttClient.setCallback(mqttCallback);
    mqttClient.setKeepAlive(60);       // 心跳间隔 60 秒
    mqttClient.setSocketTimeout(10);   // Socket 超时 10 秒

    // 5. 连接 OneNet MQTT
    connectMQTT();

    Serial.println("[System] 初始化完成，开始运行...\n");
}


// ============================================================
// loop() — 主循环
// ============================================================
void loop() {
    // 1. 检查 WiFi 连接
    if (WiFi.status() != WL_CONNECTED) {
        Serial.println("[WiFi] 连接断开，尝试重连...");
        connectWiFi();
    }

    // 2. 检查 MQTT 连接
    if (!mqttClient.connected()) {
        connectMQTT();
    }
    mqttClient.loop();  // 必须定期调用以维持 MQTT 连接和处理回调

    // 3. 读取 STM32 发来的传感器数据
    readSTM32Data();

    // 4. 定时上报（有数据就上报，与 STM32 2秒采集周期错开）
    unsigned long now = millis();
    if (now - lastPublishTime >= PUBLISH_INTERVAL) {
        lastPublishTime = now;
        publishSensorData();
    }

    delay(10);  // 让出 CPU，避免看门狗超时
}


